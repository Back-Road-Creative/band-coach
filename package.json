{
  "name": "band-coach",
  "version": "1.6.0",
  "private": true,
  "description": "Adaptive music-instrument coach that runs from a single HTML file",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "pages": "node build/build.mjs --pages",
    "shots": "node build/shots.mjs",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=$(node tests/helpers/browser.mjs) \"tests/*.test.mjs\" \"tests/build/*.test.mjs\" \"tests/characterization/*.test.mjs\" \"tests/unit/*.test.mjs\" \"tests/unit/notation/*.test.mjs\"",
    "posttest": "npm run gate",
    "gate": "node build/build.mjs --release && node --test \"tests/release/*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
